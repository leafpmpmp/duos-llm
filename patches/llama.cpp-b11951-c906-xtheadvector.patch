+#if defined(__riscv_xtheadvector)
+// The C906 hardware prefetcher does not train on vector loads: weights
+// streamed from DRAM by th.vlb.v alone reach ~1/3 of the cached rate.
+// A scalar load ahead of the vector loads fixes that. Stay inside the row.
+#define XTV_TOUCH_AHEAD 256
+
+static inline void xtv_touch(const void * p, const void * last) {
+    const uint8_t * q = (const uint8_t *) p + XTV_TOUCH_AHEAD;
+    if (q > (const uint8_t *) last) {
+        q = last;
+    }
+    uint8_t t;
+    __asm__ __volatile__("lbu %0, 0(%1)" : "=r" (t) : "r" (q));
+    (void) t;
+}
+#endif
